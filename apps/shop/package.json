{
  "name": "@alibi/shop",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "A small shop service for the Alibi example: a checkout behind a Flagsmith flag, traced with OpenTelemetry.",
  "type": "module",
  "engines": {
    "node": ">=22.15"
