# The stack needs no environment file: every password and key is generated on first start
# and written to deploy/data/shared (git-ignored). These are the names other services read.
#
# deploy/data/shared/secrets.env
DATABASE_URL=
DJANGO_SECRET_KEY=
WAREHOUSE_CREDENTIALS_SECRET=
SHOP_DATABASE_URL=
ADMIN_PASSWORD=
#
# deploy/data/shared/flagsmith.env (written by the bootstrap container)
FLAGSMITH_URL=
FLAGSMITH_INTERNAL_URL=
FLAGSMITH_ENVIRONMENT_KEY=
FLAGSMITH_SERVER_KEY=
FLAGSMITH_MASTER_KEY=
FLAGSMITH_ORG_ID=
FLAGSMITH_PROJECT_ID=
FLAGSMITH_FEATURE_ID=
FLAGSMITH_EXPERIMENT_ID=
