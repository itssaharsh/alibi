# Your Flagsmith. The address is the host root, for example https://flagsmith.example.com
FLAGSMITH_API_URL=
# The environment's client-side key (Environment Settings, or SDK Keys)
FLAGSMITH_ENVIRONMENT_KEY=
# A master API key (Organisation Settings, API Keys). Alibi uses it to read and change the experiment
FLAGSMITH_ADMIN_KEY=
# How the flag is switched off depends on this one line.
#   The flag is in a running experiment: set the experiment's id (the number in its address). Alibi sets the
#   experiment's rollout to 0%, sends exposures and metrics from your spans, and puts Flagsmith's own numbers in the record.
#   The flag is NOT in an experiment: leave it empty. Alibi disables the flag in the environment, sends no experiment
#   events and reads no experiment numbers.
FLAGSMITH_EXPERIMENT_ID=
# The flag's name, and (if it is not `stable`) the value that is the previous stable version (the experiment's control)
ALIBI_FLAG=
# ALIBI_STABLE_VARIATION=stable

# Optional
# FLAGSMITH_FEATURE_ID=           the flag's id, to find its feature state without the name (flag not in an experiment)
# ALIBI_SWITCH_OFF=               rollout-zero or disable-feature; overrides the choice made from FLAGSMITH_EXPERIMENT_ID
# FLAGSMITH_FEATURE_HEALTH_URL=   the Feature Health webhook address, to mark the flag unhealthy after a switch-off
# ALIBI_THRESHOLD=15              switch off when more than this many flagged-path failures
# ALIBI_WATCH_MS=300000           how long to watch after the switch-off
# ALIBI_CONTROL_TOKEN=            protects POST /api/arm, /api/world and /api/finish
# ALIBI_BIND=127.0.0.1            set to 0.0.0.0 so a collector on another machine can reach port 4319
# ALIBI_BOARD_PORT=4173
